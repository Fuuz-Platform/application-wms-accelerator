          "name": "Query Order Data",
          "type": "query",
          "data": {
            "api": "application",
            "variablesTransform": "$",
            "query": "query ($orderIds: [String!]!){\r\n  order(\r\n    where:  {\r\n       id:{\r\n        _in: $orderIds\r\n       }\r\n    }\r\n  ){\r\n    edges{\r\n      node{\r\n        id\r\n        number\r\n        orderLines{\r\n          edges{\r\n            node{\r\n              orderLineReleases{\r\n                edges{\r\n                  node{\r\n                    orderLineReleaseStatusId\r\n                    _aggregate{\r\n                      orderLineReleaseStatusId{\r\n                        count\r\n                      }\r\n                    }\r\n                  }\r\n                }\r\n              }\r\n            }\r\n          }\r\n        }\r\n      }\r\n    }\r\n  }\r\n}",
            "nextNodes": [
              "c9730acc-a3c6-49be-82dd-683938553b4f"
            ]
          },
          "debug": {
            "breakpointEnabled": false,
            "publishSubscribeClient": false,
            "publishToMFGx": false
          },
          "logging": {
            "executionMetrics": false,
            "executionStarted": false,
