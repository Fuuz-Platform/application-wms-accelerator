            "executionFailed": true,
            "enableTraceLogging": false
          }
        },
        {
          "id": "c9730acc-a3c6-49be-82dd-683938553b4f",
          "name": "Prepare Payload",
          "type": "transform",
          "data": {
            "transform": "order.edges.node.(\r\n\r\n  $orderStatusId :=  $all( [$.**.orderLineReleases.edges.node.orderLineReleaseStatusId], function($v){$v = \"fulfilled\"})? \"fulfilled\" :\r\n    $any([$.**.orderLineReleases.edges.node.orderLineReleaseStatusId], function($v) { $v = \"partialFulfillment\" or $v = \"fulfilled\" })?  \"partialFulfillment\";\r\n\r\n  {\r\n    \"where\":{ \"id\": id},\r\n    \"update\":{\r\n      \"orderStatusId\": $orderStatusId\r\n    }\r\n  }\r\n)",
            "nextNodes": [
              "860d9485-6e9f-4eab-b6da-913c1cbf08d5"
            ]
          },
