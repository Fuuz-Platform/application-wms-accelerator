                      "type": "mutation",
                      "api": "Application",
                      "mutation": "mutation CreateBusinessPartnerAddress($payload: [BusinessPartnerAddressCreatePayloadInput!]!) {\n  createBusinessPartnerAddress(payload: $payload) {\n    id\n    code\n  }\n}",
                      "transforms": {
                        "pre": "(\r\n  $addressToString := function($address){(\r\n    $lines := $join($address.lines, \"\\n\");\r\n    $everythingElse := $join([$address.city, $address.state, $address.postalCode, $address.country][$isNotNilOrEmpty($)], \", \");\r\n\r\n    $join([$lines, $everythingElse], \"\\n\");\r\n\r\n  )};\r\n\r\n  $metadata.urlParameters.businessPartnerId?(\r\n    $data :=data~>| $ | { \r\n      \"businessPartnerId\": $metadata.urlParameters.businessPartnerId,\r\n      \"textAddress\": textAddress? textAddress : $addressToString(address) \r\n      }, \r\n      [\"total\", \"edges\", \"id\"] |;\r\n    \r\n    {\r\n      \"payload\":{\r\n        \"create\": $data    \r\n      }\r\n    }\r\n  )\r\n  :\r\n  $throw(\"No Business Partner Id Provided.\")\r\n)"
                      }
                    },
                    {
                      "type": "transformation",
                      "transformation": "\r\n$components.OrderLineCreateForm.fn.setValue(\"businessPartnerAddress\", $first($$.createBusinessPartnerAddress))",
