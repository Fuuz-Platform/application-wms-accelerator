                      "mutation": "mutation UpsertOrderLine($payload: [OrderLineUpsertPayloadInput!]!) {\n  upsertOrderLine(payload: $payload) {\n    id\n  }\n}",
                      "transforms": {
                        "pre": "(\r\n\r\n  $metadata.urlParameters.orderId?(\r\n    $id := $coalesce([$metadata.urlParameters.id, $cuid()]);\r\n    $data := $components.OrderLineCreateForm.data~>| $ | \r\n      { \r\n        \"orderId\":  $metadata.urlParameters.orderId,\r\n        \"productId\": product.id,\r\n        \"businessPartnerAddressId\":  businessPartnerAddress.id\r\n      }, \r\n      [\"total\", \"edges\", \"id\", \"businessPartnerAddress\", \"product\"] |;\r\n    \r\n    {\r\n      \"payload\":{\r\n        \"where\": { \"id\": $id },\r\n        \"update\": $data,\r\n        \"create\": $data    \r\n      }\r\n    }\r\n  )\r\n  :\r\n  $throw(\"No Order Id Provided.\")\r\n)",
                        "post": "$components.Screen.fn.return()"
                      }
                    }
                  ]
